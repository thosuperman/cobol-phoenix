{$PHOENIX_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 30MB
	}
	reverse_proxy 127.0.0.1:3000
}

# Secondary hostnames (comma separated) permanently redirect to the primary domain.
{$PHOENIX_REDIRECT_DOMAINS} {
	redir https://{$PHOENIX_DOMAIN}{uri} permanent
}
