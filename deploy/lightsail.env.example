# Copy to /opt/cobol-phoenix/.env on the server
PHOENIX_DOMAIN=cobol.beauty
PHOENIX_REDIRECT_DOMAINS=www.cobol.beauty, cobol-phoenix.kiriwake.jp
PHOENIX_CORS_ORIGINS=https://cobol.beauty
PHOENIX_WEB_PORT=127.0.0.1:3000
PHOENIX_API_PORT=127.0.0.1:8000
PHOENIX_ALLOW_GITHUB_IMPORT=true
PHOENIX_LLM_PROVIDER=none
