# Copy to .env (git-ignored). All settings are optional.
# Ports used by docker compose
PHOENIX_WEB_PORT=3000
PHOENIX_API_PORT=8000
PHOENIX_CORS_ORIGINS=http://localhost:3000

# COBOL execution: docker (local dev) | queue (compose sidecar) | disabled
PHOENIX_COBOL_EXECUTOR=docker
PHOENIX_RUNNER_IMAGE=cobol-phoenix-runner:latest

# Imports
PHOENIX_ALLOW_GITHUB_IMPORT=true
PHOENIX_ALLOW_LOCAL_IMPORT=false
# PHOENIX_LOCAL_IMPORT_ROOT=/srv/cobol
PHOENIX_MAX_UPLOAD_MB=25

# Database (default: SQLite in PHOENIX_DATA_DIR). PostgreSQL example:
# PHOENIX_DATABASE_URL=postgresql+psycopg://phoenix:change-me@db:5432/phoenix

# Optional AI explanations (advisory only): none | openai-compatible | anthropic
PHOENIX_LLM_PROVIDER=none
# PHOENIX_LLM_BASE_URL=http://localhost:11434/v1
# PHOENIX_LLM_MODEL=
# PHOENIX_LLM_API_KEY=
